{
  "expo": {
    "name": "Minion",
    "slug": "minion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/ihate.jpg",
    "scheme": "minion",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./src/assets/ihate.jpg"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/ihate.jpg"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.notbad007.minion"
    },
    "web": {
      "output": "single",
      "favicon": "./src/assets/ihate.jpg"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./src/assets/ihate.jpg",
            "imageWidth": 200
          }
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "333363c7-b4be-4e9c-8c86-20b183742259"
      }
    }
  }
}
